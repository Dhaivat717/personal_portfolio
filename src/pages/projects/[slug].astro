---
/**
 * A Personal project's Deep dive: summary (title, pitch, meta strip, main
 * media), then the MDX body, whose h2s must be the spine (see deepDive.ts).
 * The body can use `<Media>` (clips and images) without importing it.
 * A sticky table of contents lists those h2s; previous/next cards follow `order`.
 */
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import Media from "../../components/Media.astro";
import MetaStrip from "../../components/MetaStrip.astro";
import { spineHeadings, warnOnWordCount } from "../../deepDive";
import Base from "../../layouts/Base.astro";
import { getProjects, projectHref, type Project } from "../../projects";
import { site } from "../../settings";

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, previous: projects[i - 1], next: projects[i + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
  previous?: Project;
  next?: Project;
}

const { project, previous, next } = Astro.props;
const { title, pitch, stack, links, media } = project.data;
const { Content, headings } = await render(project);
const toc = spineHeadings(project, headings);
warnOnWordCount(project);

const softwareJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: title,
  description: pitch,
  url: new URL(projectHref(project), site.origin).href,
  codeRepository: links.code,
  programmingLanguage: stack,
  author: {
    "@type": "Person",
    "@id": `${site.origin}/#person`,
    name: site.name,
    url: site.origin,
  },
};

const pager = [
  previous && { rel: "prev", label: "Previous", project: previous },
  next && { rel: "next", label: "Next", project: next },
].filter((card) => !!card);
---

<Base
  title={`${title} · ${site.name}`}
  description={pitch}
  ogImage={`/og/projects/${project.id}.png`}
  ogType="article"
  jsonLd={softwareJsonLd}
>
  <div class="wrap deep-dive">
    <header class="summary">
      <a class="back" href="/projects">← Projects</a>
      <h1>{title}</h1>
      <p class="pitch">{pitch}</p>
      <MetaStrip project={project} />
      <Media src={media.src} poster={media.poster} alt={media.alt} caption={media.caption} priority />
    </header>

    <nav class="toc" aria-label="On this page">
      <p class="toc-title" aria-hidden="true">On this page</p>
      <ol>
        {
          toc.map((h) => (
            <li>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))
        }
      </ol>
    </nav>

    <article class="prose">
      <Content components={{ Media }} />
    </article>

    {
      pager.length > 0 && (
        <nav class="pager" aria-label="More projects">
          {pager.map((card) => (
            <a class:list={["card", card.rel]} href={projectHref(card.project)} rel={card.rel}>
              <span class="dir">{card.label}</span>
              <span class="name">{card.project.data.title}</span>
              <span class="card-pitch">{card.project.data.pitch}</span>
            </a>
          ))}
        </nav>
      )
    }
  </div>
</Base>

<script>
  import { trackEvent } from "../../analytics";

  const sentinel =
    document.getElementById("what-i-learned") ?? document.getElementById("results");

  if (sentinel && "IntersectionObserver" in window) {
    let fired = false;
    const observer = new IntersectionObserver((entries) => {
      if (fired) return;
      for (const entry of entries) {
        if (entry.isIntersecting || entry.boundingClientRect.top < 0) {
          fired = true;
          trackEvent("deep-dive-read");
          observer.disconnect();
          break;
        }
      }
    });
    observer.observe(sentinel);
  }

  const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a[href^="#"]'));
  const sections = tocLinks
    .map((link) => {
      const id = link.getAttribute("href")?.slice(1);
      const heading = id ? document.getElementById(id) : null;
      return heading ? { link, heading } : null;
    })
    .filter((entry): entry is { link: HTMLAnchorElement; heading: HTMLElement } => entry !== null);

  if (sections.length > 0) {
    let activeLink: HTMLAnchorElement | null = null;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const setActive = (link: HTMLAnchorElement) => {
      if (link === activeLink) return;
      activeLink?.removeAttribute("aria-current");
      link.setAttribute("aria-current", "location");
      if (window.innerWidth < 1000) {
        link.scrollIntoView({
          behavior: reducedMotion ? "auto" : "smooth",
          inline: "center",
          block: "nearest",
        });
      }
      activeLink = link;
    };

    const updateActive = () => {
      const navHeight =
        parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--nav-h")) || 52;
      const threshold = navHeight + (window.innerWidth < 1000 ? 104 : 64);
      const atBottom =
        window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;

      if (atBottom) {
        setActive(sections[sections.length - 1].link);
        return;
      }

      let current = sections[0];
      for (const section of sections) {
        if (section.heading.getBoundingClientRect().top <= threshold) {
          current = section;
        } else {
          break;
        }
      }
      setActive(current.link);
    };

    let rafId = 0;
    const scheduleUpdate = () => {
      if (rafId) return;
      rafId = window.requestAnimationFrame(() => {
        rafId = 0;
        updateActive();
      });
    };

    updateActive();
    window.addEventListener("scroll", scheduleUpdate, { passive: true });
    window.addEventListener("resize", scheduleUpdate, { passive: true });
    window.addEventListener("hashchange", scheduleUpdate);
  }
</script>

<style>
  .deep-dive {
    display: grid;
    grid-template-columns: minmax(0, var(--narrow));
    grid-template-areas: "summary" "toc" "body" "pager";
    justify-content: center;
    column-gap: 56px;
    padding-top: 48px;
    padding-bottom: 72px;
  }
  .summary {
    grid-area: summary;
  }
  .toc {
    grid-area: toc;
  }
  .prose {
    grid-area: body;
  }
  .pager {
    grid-area: pager;
  }
  @media (min-width: 1000px) {
    .deep-dive {
      grid-template-columns: minmax(0, var(--narrow)) 200px;
      grid-template-areas: "summary toc" "body toc" "pager toc";
    }
    .toc {
      align-self: start;
      position: sticky;
      top: calc(var(--nav-h) + 32px);
      margin-top: 0;
      padding-top: 6px;
    }
  }

  .back {
    display: inline-block;
    margin-bottom: 24px;
    font-size: 15px;
    color: var(--accent);
    text-decoration: none;
  }
  .back:hover {
    text-decoration: underline;
  }
  h1 {
    font-size: clamp(32px, 4.5vw, 48px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0;
    color: var(--fg-strong);
  }
  .pitch {
    margin: 12px 0 0;
    font-size: 21px;
    line-height: 1.4;
    color: var(--muted);
  }

  .toc {
    margin-top: 40px;
    font-size: 14px;
  }
  .toc-title {
    margin: 0 0 8px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 1px solid var(--line);
  }
  .toc a {
    display: block;
    padding: 5px 0 5px 14px;
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--muted);
    text-decoration: none;
    transition:
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }
  .toc a:hover,
  .toc a:focus-visible {
    color: var(--accent);
  }
  .toc a[aria-current="location"] {
    color: var(--accent);
    border-left-color: var(--accent);
    font-weight: 600;
  }

  @media (max-width: 999px) {
    .toc {
      position: sticky;
      top: var(--nav-h);
      z-index: 20;
      margin: 24px -22px 0;
      padding: 10px 22px;
      background: var(--glass);
      backdrop-filter: saturate(180%) blur(16px);
      -webkit-backdrop-filter: saturate(180%) blur(16px);
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }
    .toc-title {
      display: none;
    }
    .toc ol {
      display: flex;
      gap: 8px;
      border-left: none;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .toc ol::-webkit-scrollbar {
      display: none;
    }
    .toc a {
      white-space: nowrap;
      padding: 5px 12px;
      margin-left: 0;
      border: 1px solid var(--line);
      border-radius: 980px;
      font-size: 13px;
      background: var(--surface);
    }
    .toc a[aria-current="location"] {
      color: var(--accent);
      border-color: var(--accent);
      background: var(--accent-fill);
      font-weight: 600;
    }
    .prose :global(h2) {
      scroll-margin-top: calc(var(--nav-h) + 64px);
    }
  }

  .prose {
    margin-top: 8px;
    font-size: 17px;
  }
  .prose :global(h2) {
    margin: 56px 0 0;
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--fg-strong);
    scroll-margin-top: calc(var(--nav-h) + 24px);
  }
  .prose :global(h3) {
    margin: 32px 0 0;
    font-size: 20px;
    font-weight: 600;
    color: var(--fg-strong);
    scroll-margin-top: calc(var(--nav-h) + 24px);
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 16px 0 0;
  }
  .prose :global(a) {
    color: var(--accent);
  }
  .prose :global(:not(pre) > code) {
    font: 0.88em var(--mono);
    padding: 2px 6px;
    border-radius: 6px;
    background: var(--hover);
  }
  /* Code excerpts: always dark (Shiki's github-dark-high-contrast), in both themes. */
  .prose :global(pre) {
    margin: 20px 0 0;
    padding: 18px 20px;
    border-radius: 12px;
    font: 14px/1.6 var(--mono);
    overflow-x: auto;
  }

  .pager {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
    margin-top: 72px;
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 20px 22px;
    border: 1px solid var(--line);
    border-radius: 16px;
    color: inherit;
    text-decoration: none;
    transition: background-color var(--dur) var(--ease);
  }
  .card:hover {
    background: var(--hover);
  }
  .card.next {
    grid-column: -2;
    text-align: right;
  }
  .dir {
    font: 12px var(--mono);
    color: var(--muted);
  }
  .prev .dir::before {
    content: "← ";
  }
  .next .dir::after {
    content: " →";
  }
  .name {
    font-size: 18px;
    font-weight: 600;
    color: var(--fg-strong);
  }
  .card-pitch {
    font-size: 15px;
    color: var(--muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .toc a,
    .card {
      transition: none;
    }
  }
</style>
