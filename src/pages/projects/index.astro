---
import ProjectRow from "../../components/ProjectRow.astro";
import Base from "../../layouts/Base.astro";
import { getProjects, projectHref } from "../../projects";
import { site } from "../../settings";

const projects = await getProjects();
const title = `Projects · ${site.name}`;
const description = `Personal projects by ${site.name}: what each one does, how it's built and what was learned.`;

const collectionJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${site.origin}/projects#collection`,
  url: `${site.origin}/projects`,
  name: title,
  description,
  isPartOf: { "@id": site.jsonLdIds.website },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: projects.length,
    itemListElement: projects.map((project, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: project.data.title,
      url: new URL(projectHref(project), site.origin).href,
    })),
  },
};
---

<Base title={title} description={description} ogImage="/og/projects.png" jsonLd={collectionJsonLd}>
  <div class="wrap page">
    <h1>Projects</h1>
    <ul class="list">
      {
        projects.map((project) => (
          <li>
            <ProjectRow project={project} />
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .page {
    padding-top: 72px;
    padding-bottom: 72px;
  }
  h1 {
    font-size: clamp(32px, 4.5vw, 48px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0 0 24px;
    color: var(--fg-strong);
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
</style>
