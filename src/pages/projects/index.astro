---
import ProjectRow from "../../components/ProjectRow.astro";
import Base from "../../layouts/Base.astro";
import { getProjects } from "../../projects";
import { site } from "../../settings";

const projects = await getProjects();
---

<Base
  title={`Projects · ${site.name}`}
  description={`Personal projects by ${site.name}: what each one does, how it's built and what was learned.`}
  ogImage="/og/projects.png"
>
  <div class="wrap page">
    <h1>Projects</h1>
    <ul class="list">
      {
        projects.map((project) => (
          <li>
            <ProjectRow project={project} />
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .page {
    padding-top: 72px;
    padding-bottom: 72px;
  }
  h1 {
    font-size: clamp(32px, 4.5vw, 48px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0 0 24px;
    color: var(--fg-strong);
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
</style>
