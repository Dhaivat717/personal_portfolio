---
import Base from "../../layouts/Base.astro";
import { site } from "../../settings";
---

<Base title={`Message sent · ${site.name}`} noindex>
  <div class="narrow result">
    <h1>Message sent.</h1>
    <p>Thanks — your message has been sent. I'll reply when I get a chance.</p>
    <p><a href="/#contact">← Back to contact form</a></p>
  </div>
</Base>

<style>
  .result {
    padding-top: 96px;
  }
  h1 {
    font-size: clamp(32px, 4.5vw, 48px);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 12px;
    color: var(--fg-strong);
  }
  p {
    color: var(--muted);
    max-width: 52ch;
  }
  a {
    color: var(--accent);
    font-weight: 600;
  }
</style>
