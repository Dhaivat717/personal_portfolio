---
import Base from "../../layouts/Base.astro";
import { site } from "../../settings";
---

<Base title={`Message not sent · ${site.name}`} noindex>
  <div class="narrow result">
    <h1>Message not sent.</h1>
    <p>
      Your message could not be delivered. Please check that your name, email address, and message
      are filled in, and ensure JavaScript is enabled so the anti-spam verification check can
      complete.
    </p>
    <p><a href="/#contact">← Back to contact form</a></p>
  </div>
</Base>

<style>
  .result {
    padding-top: 96px;
  }
  h1 {
    font-size: clamp(32px, 4.5vw, 48px);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 12px;
    color: var(--fg-strong);
  }
  p {
    color: var(--muted);
    max-width: 56ch;
  }
  a {
    color: var(--accent);
    font-weight: 600;
  }
</style>
