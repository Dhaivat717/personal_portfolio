---
import ContactForm from "../components/ContactForm.astro";
import Experience from "../components/Experience.astro";
import Hero from "../components/Hero.astro";
import ProjectRow from "../components/ProjectRow.astro";
import Base from "../layouts/Base.astro";
import { getFeaturedProjects } from "../projects";
import { site } from "../settings";

const featuredProjects = await getFeaturedProjects();

const roleLabel = `${site.role.charAt(0)}${site.role.slice(1).toLowerCase()}`;
const description = `${roleLabel} at ${site.employer} with ${site.yearsOfExperience} years of experience building distributed systems, developer tools and personal projects.`;

const originHost = new URL(site.origin).hostname;
const homeJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": site.jsonLdIds.website,
      url: site.origin,
      name: site.name,
      alternateName: [originHost],
      publisher: { "@id": site.jsonLdIds.person },
    },
    {
      "@type": "ProfilePage",
      "@id": `${site.origin}/#profile`,
      url: `${site.origin}/`,
      mainEntity: { "@id": site.jsonLdIds.person },
      isPartOf: { "@id": site.jsonLdIds.website },
    },
    {
      "@type": "Person",
      "@id": site.jsonLdIds.person,
      name: site.name,
      alternateName: [...site.alternateNames],
      jobTitle: site.role,
      worksFor: {
        "@type": "Organization",
        name: site.employer,
        parentOrganization: { "@type": "Organization", name: site.parentEmployer },
      },
      url: site.origin,
      image: new URL(site.image, site.origin).href,
      alumniOf: { "@type": "CollegeOrUniversity", name: site.alumniOf },
      homeLocation: { "@type": "Place", name: site.location },
      knowsAbout: [...site.knowsAbout],
      sameAs: [site.social.github, site.social.linkedin],
    },
  ],
};
---

<Base
  title={`${site.name} · ${site.role} @ ${site.employer}`}
  description={description}
  ogImage={site.image}
  jsonLd={homeJsonLd}
>
  <Hero />

  <Experience />

  <section id="projects" class="band" aria-labelledby="projects-heading">
    <div class="wrap">
      <h2 id="projects-heading">Projects</h2>
      <ul class="project-list">
        {
          featuredProjects.map((project) => (
            <li>
              <ProjectRow project={project} headingLevel={3} />
            </li>
          ))
        }
      </ul>
      <a class="more" href="/projects">All projects →</a>
    </div>
  </section>

  <ContactForm />
</Base>

<style>
  #projects.band {
    padding-top: 56px;
  }
  .project-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .more {
    display: inline-block;
    margin-top: 22px;
    font: 14px var(--mono);
    color: var(--accent);
    text-decoration: none;
  }
  .more:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
