---
import ProjectRow from "../components/ProjectRow.astro";
import Base from "../layouts/Base.astro";
import { getFeaturedProjects } from "../projects";
import { site } from "../settings";

const featuredProjects = await getFeaturedProjects();

const roleLabel = `${site.role.charAt(0)}${site.role.slice(1).toLowerCase()}`;
const description = `${roleLabel} at ${site.employer} with ${site.yearsOfExperience} years of experience building distributed systems, developer tools and personal projects.`;

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${site.origin}/#person`,
  name: site.name,
  jobTitle: site.role,
  worksFor: { "@type": "Organization", name: site.employer },
  url: site.origin,
  image: new URL(site.image, site.origin).href,
  alumniOf: { "@type": "CollegeOrUniversity", name: site.alumniOf },
  sameAs: [site.social.github, site.social.linkedin],
};
---

<Base title={`${site.name} · ${site.role} @ ${site.employer}`} description={description} jsonLd={personJsonLd}>
  <div class="wrap hero">
    <h1>{site.name}</h1>
    <div class="chips">
      <span class="chip">{site.role}</span>
      <span class="chip">{site.employer}</span>
    </div>
  </div>

  <!-- Placeholders: later tickets fill these Sections. -->
  <section id="experience"></section>

  <section id="projects" class="band" aria-labelledby="projects-heading">
    <div class="wrap">
      <h2 id="projects-heading">Projects.</h2>
      <ul class="project-list">
        {
          featuredProjects.map((project) => (
            <li>
              <ProjectRow project={project} headingLevel={3} />
            </li>
          ))
        }
      </ul>
      <a class="more" href="/projects">All projects →</a>
    </div>
  </section>

  <section id="contact"></section>
</Base>

<style>
  .hero {
    padding: 72px 22px 56px;
    text-align: center;
  }
  h1 {
    font-size: clamp(34px, 5vw, 56px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0;
    color: var(--fg-strong);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin-top: 14px;
  }
  .chip {
    display: inline-block;
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-fill);
    border-radius: 980px;
    padding: 4px 12px;
  }
  .band {
    padding: 88px 0;
  }
  .band h2 {
    font-size: clamp(32px, 4.5vw, 48px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0 0 24px;
    color: var(--fg-strong);
  }
  .project-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .more {
    display: inline-block;
    margin-top: 22px;
    font: 14px var(--mono);
    color: var(--accent);
    text-decoration: none;
  }
  .more:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
