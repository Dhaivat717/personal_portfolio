---
/**
 * The theme switch: a sliding "Dark mode" switch. The knob sits left with a
 * sun in light mode and slides right, turning into a moon, in dark mode.
 * Until the Visitor flips it, the theme follows the OS; flipping it saves the
 * choice for later visits. Hidden without JavaScript, where the page simply
 * follows the OS.
 */
---

<button class="switch" type="button" role="switch" aria-label="Dark mode" aria-checked="false" data-theme-toggle hidden>
  <span class="knob">
    <svg class="icon sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle class="core" cx="12" cy="12" r="4.5"></circle>
      <g class="rays">
        <line x1="12" y1="1.5" x2="12" y2="4"></line>
        <line x1="12" y1="20" x2="12" y2="22.5"></line>
        <line x1="1.5" y1="12" x2="4" y2="12"></line>
        <line x1="20" y1="12" x2="22.5" y2="12"></line>
        <line x1="4.6" y1="4.6" x2="6.3" y2="6.3"></line>
        <line x1="17.7" y1="17.7" x2="19.4" y2="19.4"></line>
        <line x1="4.6" y1="19.4" x2="6.3" y2="17.7"></line>
        <line x1="17.7" y1="6.3" x2="19.4" y2="4.6"></line>
      </g>
    </svg>
    <svg class="icon moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1z"></path>
    </svg>
  </span>
</button>

<script>
  type Theme = "light" | "dark";

  const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const root = document.documentElement;
  const osDark = window.matchMedia("(prefers-color-scheme: dark)");

  function currentTheme(): Theme {
    const chosen = root.dataset.theme;
    if (chosen === "light" || chosen === "dark") return chosen;
    return osDark.matches ? "dark" : "light";
  }

  function render(el: HTMLButtonElement) {
    el.setAttribute("aria-checked", String(currentTheme() === "dark"));
  }

  if (toggle) {
    toggle.addEventListener("click", () => {
      const next: Theme = currentTheme() === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {
        // Storage blocked: the switch still applies for this page view.
      }
      render(toggle);
    });
    osDark.addEventListener("change", () => render(toggle));
    render(toggle);
    toggle.hidden = false;
  }
</script>

<style>
  .switch {
    --track-w: 60px;
    --track-h: 32px;
    --knob: 26px;
    --gap: 2px;

    position: relative;
    display: inline-block;
    width: var(--track-w);
    height: var(--track-h);
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--hover);
    cursor: pointer;
    transition:
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }
  .switch[hidden] {
    display: none;
  }

  .knob {
    position: absolute;
    top: var(--gap);
    left: var(--gap);
    display: grid;
    place-items: center;
    width: var(--knob);
    height: var(--knob);
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.25);
    transition: transform var(--dur-long) var(--ease-emph);
  }
  .switch:active .knob {
    width: calc(var(--knob) + 4px);
    border-radius: 999px;
  }

  .icon {
    position: absolute;
    width: 16px;
    height: 16px;
    transition:
      transform var(--dur-long) var(--ease-emph),
      opacity var(--dur) var(--ease);
  }
  .sun {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
  }
  .sun .core {
    fill: currentColor;
  }
  .moon {
    fill: currentColor;
    opacity: 0;
    transform: rotate(-90deg) scale(0.4);
  }

  /* Dark: the knob slides right; the sun sets as the moon swings up. */
  .switch[aria-checked="true"] .knob {
    transform: translateX(calc(var(--track-w) - var(--knob) - 2 * var(--gap) - 2px));
  }
  .switch[aria-checked="true"]:active .knob {
    transform: translateX(calc(var(--track-w) - var(--knob) - 2 * var(--gap) - 6px));
  }
  .switch[aria-checked="true"] .sun {
    opacity: 0;
    transform: rotate(90deg) scale(0.4);
  }
  .switch[aria-checked="true"] .moon {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .switch,
    .knob,
    .icon {
      transition: none;
    }
  }
</style>
