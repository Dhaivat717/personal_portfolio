---
/**
 * The site nav: name · Experience · Projects ▾ · Contact · Résumé · Dark mode
 * switch. Section links always point to Home page anchors, so they work the
 * same from any page.
 *
 * Projects ▾ is a button (with JS) that opens a drop-down of Deep dives, lowest
 * `order` first, capped at 8, with the current one marked, always ending with
 * "All projects →". Without JS it is a plain link to /projects.
 *
 * At phone width (with JS) the links and Résumé collapse into a menu behind a
 * button; the Dark mode switch stays in the bar beside it. Without JS there is
 * no menu button and every link stays visible.
 */
import { getProjects } from "../projects";
import { site } from "../settings";
import ThemeToggle from "./ThemeToggle.astro";

/** The drop-down lists at most this many projects; "All projects →" covers the rest. */
const MAX_NAV_PROJECTS = 8;
const projects = (await getProjects()).slice(0, MAX_NAV_PROJECTS);
// The built page's path ends in ".html" (build.format "file"); dev's doesn't.
const currentPath = Astro.url.pathname.replace(/\.html$/, "");

const resumeDownloadName = `${site.name.replaceAll(" ", "-")}-Resume.pdf`;
---

<header class="nav" data-nav>
  <nav class="wrap bar" aria-label="Main">
    <a class="brand" href="/">{site.name}</a>
    <button class="menu-btn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav-menu" data-menu-button>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <line class="top" x1="4" y1="8" x2="20" y2="8"></line>
        <line class="bottom" x1="4" y1="16" x2="20" y2="16"></line>
      </svg>
    </button>
    <div class="menu" id="nav-menu">
      <ul class="links">
        <li><a href="/#experience">Experience</a></li>
        <li class="projects" data-projects>
          <a class="projects-link" href="/projects">Projects</a>
          <button class="projects-btn" type="button" aria-expanded="false" aria-controls="nav-projects" data-projects-button>
            Projects
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6"></path></svg>
          </button>
          <ul class="dropdown" id="nav-projects">
            {
              projects.map((project) => (
                <li>
                  <a
                    href={`/projects/${project.id}`}
                    aria-current={currentPath === `/projects/${project.id}` ? "page" : undefined}
                  >
                    {project.data.title}
                  </a>
                </li>
              ))
            }
            <li><a class="all" href="/projects">All projects →</a></li>
          </ul>
        </li>
        <li><a href="/#contact">Contact</a></li>
      </ul>
      <a class="resume" href="/resume.pdf" download={resumeDownloadName} title="Download résumé (PDF)">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" data-download-icon>
          <path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19.5h14"></path>
        </svg>
        Résumé
      </a>
    </div>
    <ThemeToggle />
  </nav>
</header>

<script>
  // Frosted glass once the page has scrolled away from the very top.
  const header = document.querySelector<HTMLElement>("[data-nav]");
  if (header) {
    const markScrolled = () => header.classList.toggle("scrolled", window.scrollY > 8);
    window.addEventListener("scroll", markScrolled, { passive: true });
    markScrolled();
  }

  /** A button whose aria-expanded drives what CSS shows. */
  const disclosure = (button: HTMLButtonElement) => ({
    button,
    isOpen: () => button.getAttribute("aria-expanded") === "true",
    setOpen: (open: boolean) => button.setAttribute("aria-expanded", String(open)),
  });

  const menuButton = document.querySelector<HTMLButtonElement>("[data-menu-button]");
  const menuPanel = document.getElementById("nav-menu");
  const projectsButton = document.querySelector<HTMLButtonElement>("[data-projects-button]");
  const projectsItem = document.querySelector<HTMLElement>("[data-projects]");
  const menu = menuButton && disclosure(menuButton);
  const projects = projectsButton && disclosure(projectsButton);

  // Phone menu: toggled by its button; a link or a click outside closes it.
  if (menu && menuPanel) {
    menu.button.addEventListener("click", () => menu.setOpen(!menu.isOpen()));
    menuPanel.addEventListener("click", (e) => {
      if ((e.target as Element).closest("a")) menu.setOpen(false);
    });
    document.addEventListener("click", (e) => {
      const target = e.target as Node;
      if (menu.isOpen() && !menuPanel.contains(target) && !menu.button.contains(target)) menu.setOpen(false);
    });
  }

  // Projects drop-down: click, Enter or Space toggles it; on desktop, hovering
  // opens it too. Focus or a click leaving it closes it.
  if (projects && projectsItem) {
    const desktopHover = window.matchMedia("(hover: hover) and (min-width: 721px)");
    let openedByHover = false;
    let closeTimer: number | undefined;

    projects.button.addEventListener("click", () => {
      // A click on a hover-opened drop-down keeps it open rather than closing it.
      projects.setOpen((openedByHover && projects.isOpen()) || !projects.isOpen());
      openedByHover = false;
    });
    projectsItem.addEventListener("mouseenter", () => {
      window.clearTimeout(closeTimer);
      if (!desktopHover.matches || projects.isOpen()) return;
      openedByHover = true;
      projects.setOpen(true);
    });
    projectsItem.addEventListener("mouseleave", () => {
      if (!openedByHover) return;
      closeTimer = window.setTimeout(() => {
        openedByHover = false;
        projects.setOpen(false);
      }, 200);
    });
    projectsItem.addEventListener("focusout", (e) => {
      const next = e.relatedTarget as Node | null;
      if (next && !projectsItem.contains(next)) projects.setOpen(false);
    });
    document.addEventListener("click", (e) => {
      if (projects.isOpen() && !projectsItem.contains(e.target as Node)) projects.setOpen(false);
    });
  }

  // Esc closes the innermost open thing (the drop-down, then the phone menu)
  // and returns focus to the button that opened it.
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    const open = [projects, menu].find((d) => d?.isOpen());
    if (!open) return;
    open.setOpen(false);
    open.button.focus();
  });
</script>

<style>
  /*
   * Clear at the top, frosted glass once scrolled. The hairline border is
   * always there (transparent at the top), so the switch never shifts layout.
   */
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      backdrop-filter var(--dur) var(--ease);
  }
  .nav.scrolled {
    background: var(--glass);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border-bottom-color: var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 22px;
    height: var(--nav-h);
  }
  .brand {
    margin-right: auto;
    font-weight: 600;
    color: var(--fg-strong);
    text-decoration: none;
  }
  .links {
    display: flex;
    gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
  }
  .links > li > a,
  .projects-btn {
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  .links > li > a:hover,
  .projects-btn:hover,
  .projects-btn[aria-expanded="true"] {
    color: var(--fg);
  }

  /*
   * Projects ▾: without JS, a plain link to /projects. With JS, a button that
   * opens a drop-down panel under it.
   */
  .projects {
    position: relative;
  }
  .projects-btn,
  .dropdown {
    display: none;
  }
  :global(html.js) .projects-link {
    display: none;
  }
  :global(html.js) .projects-btn {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    cursor: pointer;
    transition: color var(--dur) var(--ease);
  }
  .projects-btn svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform var(--dur) var(--ease);
  }
  .projects-btn[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }
  :global(html.js) .projects-btn[aria-expanded="true"] + .dropdown {
    display: block;
  }
  .dropdown {
    position: absolute;
    top: calc(100% + 12px);
    left: -12px;
    min-width: 240px;
    margin: 0;
    padding: 6px;
    list-style: none;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: 0 12px 32px var(--shadow);
  }
  /* Bridges the gap under the button, so hover survives the trip down. */
  .dropdown::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: 14px;
  }
  .dropdown a {
    display: block;
    padding: 8px 10px;
    border-radius: 8px;
    color: var(--fg);
    text-decoration: none;
  }
  .dropdown a:hover {
    background: var(--hover);
  }
  .dropdown a[aria-current="page"] {
    color: var(--accent);
    font-weight: 500;
  }
  /* A dot, not text: aria-current already tells screen readers. */
  .dropdown a[aria-current="page"]::after {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-left: 8px;
    border-radius: 50%;
    background: var(--accent);
    vertical-align: middle;
  }
  .dropdown .all {
    margin-top: 4px;
    border-top: 1px solid var(--line);
    border-radius: 0 0 8px 8px;
    color: var(--accent);
  }
  .resume {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 16px;
    border-radius: 980px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: transform 150ms var(--ease);
  }
  .resume:active {
    transform: scale(0.97);
  }
  .resume svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .menu {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .menu-btn {
    display: none;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-right: -6px;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: none;
    color: var(--fg);
    cursor: pointer;
  }
  .menu-btn svg {
    width: 22px;
    height: 22px;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  .menu-btn line {
    transform-origin: center;
    transition: transform var(--dur) var(--ease);
  }
  .menu-btn[aria-expanded="true"] .top {
    transform: translateY(4px) rotate(45deg);
  }
  .menu-btn[aria-expanded="true"] .bottom {
    transform: translateY(-4px) rotate(-45deg);
  }

  @media (max-width: 720px) {
    .bar {
      gap: 12px;
    }
    /* Without JS the links simply stay in the bar, on a second row. */
    .brand {
      white-space: nowrap;
    }
    .links {
      gap: 16px;
    }
    :global(html:not(.js)) .bar {
      flex-wrap: wrap;
      row-gap: 4px;
      height: auto;
      min-height: var(--nav-h);
      padding-block: 10px;
    }
    :global(html:not(.js)) .menu {
      flex-basis: 100%;
      justify-content: space-between;
    }
    .menu .resume {
      padding: 6px 12px;
    }

    /* With JS they collapse into a panel under the bar. */
    :global(html.js) .menu-btn {
      display: grid;
    }
    :global(html.js) .menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
      padding: 8px 22px 18px;
      border-bottom: 1px solid var(--line);
      background: var(--bg);
    }
    :global(html.js) .menu-btn[aria-expanded="false"] + .menu {
      display: none;
    }
    :global(html.js) .links {
      flex-direction: column;
      gap: 0;
      font-size: 17px;
    }
    :global(html.js) .links > li > a:not(.projects-link),
    :global(html.js) .projects-btn {
      display: flex;
      width: 100%;
      padding: 10px 0;
      color: var(--fg);
    }
    :global(html.js) .projects-btn {
      justify-content: space-between;
    }
    /* Inside the phone menu, projects expand in place as an indented list. */
    :global(html.js) .dropdown {
      position: static;
      min-width: 0;
      padding: 0 0 6px 14px;
      border: 0;
      border-radius: 0;
      background: none;
      box-shadow: none;
      font-size: 15px;
    }
    .dropdown::before {
      content: none;
    }
    .dropdown a {
      padding: 8px 0;
    }
    .dropdown .all {
      margin-top: 0;
      border-top: 0;
    }
    :global(html.js) .menu .resume {
      justify-content: center;
      margin-top: 10px;
      padding: 10px 16px;
      font-size: 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav,
    .links a,
    .projects-btn,
    .projects-btn svg,
    .resume,
    .menu-btn line {
      transition: none;
    }
  }
</style>
