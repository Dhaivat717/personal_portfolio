---
/**
 * A Personal project's stack as monospace chips. Used in /projects rows and
 * the Deep dive meta strip, so the two always look the same.
 */
interface Props {
  stack: string[];
  class?: string;
}

const { stack, class: className } = Astro.props;
---

<ul class:list={["chips", className]} aria-label="Stack">
  {stack.map((item) => <li>{item}</li>)}
</ul>

<style>
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    font: 12px var(--mono);
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 3px 8px;
  }
</style>
