---
/**
 * Experience Section: renders every role newest first from the experience data
 * collection. Each role is a two-column row with a sticky left column (company,
 * monospace dates, logo in a uniform white rounded square) and a right column
 * (Title @ Company, Work highlight bullets with key figures in bold, and
 * monospace tag chips).
 */
import { Image } from "astro:assets";
import { getExperience, parseBullet } from "../experience";
import StackChips from "./StackChips.astro";

const roles = await getExperience();
---

<section id="experience" class="band" aria-labelledby="experience-heading">
  <div class="wrap">
    <h2 id="experience-heading">Experience.</h2>
    <ol class="roles">
      {
        roles.map((role) => (
          <li>
            <article class="role" data-role={role.id}>
              <div class="side">
                <strong class="company">{role.company}</strong>
                <span class="when">{role.when}</span>
                <span class="logo-box">
                  <Image src={role.logoImage} alt={role.logoAlt} width={72} height={72} />
                </span>
              </div>
              <div class="details">
                <h3>{role.title} <span class="at">@ {role.company}</span></h3>
                <ul class="bullets" data-bullets>
                  {role.bullets.map((bullet) => (
                    <li>
                      {parseBullet(bullet).map((segment) =>
                        segment.bold ? <strong>{segment.text}</strong> : segment.text,
                      )}
                    </li>
                  ))}
                </ul>
                <StackChips stack={role.tags} label="Technologies" class="tags" />
              </div>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .roles {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .role {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 40px;
    padding: 36px 0;
    border-top: 1px solid var(--line);
  }
  .side {
    position: sticky;
    top: calc(var(--nav-h) + 24px);
    align-self: start;
    border-left: 2px solid var(--accent);
    padding: 2px 0 2px 14px;
  }
  .company {
    display: block;
    font-size: 17px;
    font-weight: 600;
    color: var(--fg-strong);
    line-height: 1.3;
  }
  .when {
    display: block;
    font: 12px var(--mono);
    color: var(--muted);
    margin-top: 2px;
  }
  .logo-box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    margin-top: 12px;
    padding: 6px;
    border-radius: 10px;
    background: var(--logo-bg);
    border: 1px solid var(--line);
  }
  .logo-box img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .details {
    min-width: 0;
  }
  h3 {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0;
    color: var(--fg-strong);
    overflow-wrap: break-word;
  }
  .at {
    color: var(--accent);
  }
  .bullets {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    gap: 14px;
    font-size: 16.5px;
    line-height: 1.55;
  }
  .bullets li {
    padding-left: 22px;
    position: relative;
    overflow-wrap: break-word;
  }
  .bullets li::before {
    content: "▹";
    position: absolute;
    left: 0;
    color: var(--accent);
  }
  .details :global(.tags) {
    margin-top: 22px;
  }

  @media (max-width: 820px) {
    .role {
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 28px 0;
    }
    .side {
      position: static;
    }
  }
</style>
