---
/**
 * One Personal project as a list row: accent-tinted icon tile, name, pitch,
 * stack chips and "read →". The whole row links to the project's Deep dive.
 * Used on /projects.
 */
import type { Project } from "../projects";
import Icon from "./Icon.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, pitch, stack, icon } = project.data;
---

<a class="row" href={`/projects/${project.id}`}>
  <span class="tile"><Icon name={icon} /></span>
  <span class="body">
    <h2 class="name">{title}</h2>
    <p class="pitch">{pitch}</p>
    <ul class="stack" aria-label="Stack">
      {stack.map((item) => <li>{item}</li>)}
    </ul>
  </span>
  <span class="go" aria-hidden="true">read →</span>
</a>

<style>
  .row {
    display: grid;
    grid-template-columns: 48px 1fr auto;
    gap: 18px;
    align-items: center;
    padding: 22px 8px;
    border-bottom: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
    transition:
      background-color var(--dur) var(--ease),
      padding var(--dur) var(--ease);
  }
  .row:hover {
    background: var(--hover);
    padding-left: 16px;
  }
  .tile {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .name {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    color: var(--fg-strong);
  }
  .pitch {
    margin: 2px 0 0;
    font-size: 15px;
    color: var(--muted);
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }
  .stack li {
    font: 12px var(--mono);
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 3px 8px;
  }
  .go {
    font: 13px var(--mono);
    color: var(--muted);
  }
  .row:hover .go {
    color: var(--accent);
  }
  @media (max-width: 560px) {
    .row {
      grid-template-columns: 48px 1fr;
    }
    .go {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .row {
      transition: none;
    }
  }
</style>
