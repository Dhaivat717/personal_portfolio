---
import { site } from "../settings";
---

<section id="contact" class="contact">
  <div class="narrow">
    <h2>Say hello.</h2>
    <p class="lead">Have a role, project, or question in mind? Send a note below.</p>

    <form id="contact-form" class="form" action="/api/contact" method="post">
      <div class="field">
        <label for="contact-name">Name</label>
        <input
          id="contact-name"
          name="name"
          type="text"
          autocomplete="name"
          maxlength="120"
          required
        />
        <p id="contact-name-error" class="field-error" hidden></p>
      </div>

      <div class="field">
        <label for="contact-email">Email</label>
        <input
          id="contact-email"
          name="email"
          type="email"
          autocomplete="email"
          maxlength="254"
          required
        />
        <p id="contact-email-error" class="field-error" hidden></p>
      </div>

      <div class="field">
        <label for="contact-message">Message</label>
        <textarea
          id="contact-message"
          name="message"
          rows="5"
          maxlength="5000"
          required
        ></textarea>
        <p id="contact-message-error" class="field-error" hidden></p>
      </div>

      <div
        class="cf-turnstile"
        data-sitekey={site.turnstileSiteKey}
        data-theme="auto"
      ></div>

      <div class="actions">
        <button type="submit" class="submit-btn">Send message</button>
      </div>

      <div id="contact-status" class="form-status" role="status" aria-live="polite"></div>
    </form>
  </div>
</section>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  import { trackEvent } from "../analytics";

  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const statusEl = document.getElementById("contact-status");
  const submitBtn = form?.querySelector<HTMLButtonElement>('button[type="submit"]') ?? null;

  const FIELDS = ["name", "email", "message"] as const;
  type FieldName = (typeof FIELDS)[number];

  interface ContactResponse {
    ok: boolean;
    message?: string;
    error?: string;
    errors?: Partial<Record<FieldName, string>>;
  }

  interface TurnstileWindow extends Window {
    turnstile?: { reset?: () => void };
  }

  function setFieldError(field: FieldName, message: string | undefined) {
    const input = document.getElementById(`contact-${field}`);
    const errEl = document.getElementById(`contact-${field}-error`);
    if (!input || !errEl) return;

    if (message) {
      errEl.textContent = message;
      errEl.hidden = false;
      input.setAttribute("aria-invalid", "true");
      input.setAttribute("aria-describedby", errEl.id);
    } else {
      errEl.textContent = "";
      errEl.hidden = true;
      input.removeAttribute("aria-invalid");
      input.removeAttribute("aria-describedby");
    }
  }

  function setStatus(text: string, state: "idle" | "error" | "success") {
    if (!statusEl) return;
    statusEl.textContent = text;
    if (state === "idle") {
      statusEl.removeAttribute("data-state");
    } else {
      statusEl.setAttribute("data-state", state);
    }
  }

  if (form) {
    // Let our JS handler show field-specific errors tied via aria-describedby,
    // while keeping native HTML validation active when JS is disabled.
    form.noValidate = true;

    for (const field of FIELDS) {
      const input = document.getElementById(`contact-${field}`);
      input?.addEventListener("input", () => setFieldError(field, undefined));
    }

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      for (const field of FIELDS) setFieldError(field, undefined);
      setStatus("", "idle");

      const originalLabel = submitBtn?.textContent ?? "Send message";
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Sending…";
      }

      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        const data = (await res.json()) as ContactResponse;

        if (!res.ok || !data.ok) {
          let firstInvalid: HTMLElement | null = null;
          if (data.errors) {
            for (const field of FIELDS) {
              const msg = data.errors[field];
              setFieldError(field, msg);
              if (msg && !firstInvalid) {
                firstInvalid = document.getElementById(`contact-${field}`);
              }
            }
          }
          setStatus(data.error ?? "Could not send your message. Please try again.", "error");
          firstInvalid?.focus();
          if (!data.errors) {
            (window as TurnstileWindow).turnstile?.reset?.();
          }
          return;
        }

        form.reset();
        setStatus(data.message ?? "Thanks — your message has been sent.", "success");
        (window as TurnstileWindow).turnstile?.reset?.();
        trackEvent("contact-sent");
      } catch {
        setStatus("Network error. Please try again.", "error");
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = originalLabel;
        }
      }
    });
  }
</script>

<style>
  .contact {
    padding: 80px 0 32px;
    border-top: 1px solid var(--line);
  }
  h2 {
    font-size: clamp(32px, 4.5vw, 48px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0 0 12px;
    color: var(--fg-strong);
  }
  .lead {
    margin: 0 0 28px;
    color: var(--muted);
    font-size: 17px;
  }
  .form {
    display: grid;
    gap: 18px;
    max-width: 560px;
  }
  .field {
    display: grid;
    gap: 6px;
  }
  label {
    font-size: 14px;
    font-weight: 600;
    color: var(--fg-strong);
  }
  input,
  textarea {
    width: 100%;
    font: inherit;
    font-size: 16px;
    color: var(--fg);
    background: var(--surface);
    border: 1px solid var(--stroke);
    border-radius: 10px;
    padding: 11px 14px;
    transition: border-color var(--dur) var(--ease);
  }
  textarea {
    resize: vertical;
    min-height: 120px;
  }
  input:focus,
  textarea:focus {
    border-color: var(--accent);
  }
  input[aria-invalid="true"],
  textarea[aria-invalid="true"] {
    border-color: var(--accent);
  }
  .field-error {
    margin: 0;
    font-size: 14px;
    color: var(--accent);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .submit-btn {
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    color: var(--on-accent);
    background: var(--accent);
    border: 0;
    border-radius: 980px;
    padding: 11px 24px;
    cursor: pointer;
    transition: opacity var(--dur) var(--ease);
  }
  .submit-btn:hover:not(:disabled) {
    opacity: 0.9;
  }
  .submit-btn:disabled {
    opacity: 0.6;
    cursor: wait;
  }
  .form-status {
    min-height: 1.5em;
    font-size: 15px;
    color: var(--fg-strong);
  }
  .form-status[data-state="error"] {
    color: var(--accent);
  }
  @media (prefers-reduced-motion: reduce) {
    input,
    textarea,
    .submit-btn {
      transition: none;
    }
  }
</style>
