{
  "name": "personal-portfolio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "serve": "wrangler pages dev dist --port 8788",
    "test:unit": "vitest run tests/unit",
    "test:build": "vitest run",
    "test:contrast": "vitest run tests/unit/token-contrast.test.ts",
    "test:axe": "playwright test tests/site/axe.spec.ts",
    "test:budgets": "playwright test tests/site/budgets.spec.ts",
    "test:lighthouse": "lhci autorun",
    "test:site": "playwright test",
    "test": "npm run test:build && npm run test:site"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/react": "^7.1.9",
    "@astrojs/sitemap": "^3.7.6",
    "@iconify-json/lucide": "^1.2.155",
    "astro": "^7.4.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "satori": "^0.63.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261113.1": true
  }
}
